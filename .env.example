DJANGO_SECRET_KEY=cambia-questa-chiave
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=ordini.example.com

# Invio email (SMTP)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=ordini@example.com
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=Ordini Novecento <ordini@example.com>

# Laboratorio che riceve gli ordini (più indirizzi separati da virgola)
ORDINI_EMAIL_DESTINATARI=laboratorio@example.com
