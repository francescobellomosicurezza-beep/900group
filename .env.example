# Copia questo file in .env e completa i valori (su PythonAnywhere lo crea
# automaticamente deploy/installa_pythonanywhere.sh). Non caricare .env su GitHub.
DJANGO_SECRET_KEY=genera-una-chiave-lunga-e-casuale
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=USERNAME.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://USERNAME.pythonanywhere.com

# Invio email con Gmail (serve la "password per le app")
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_HOST_USER=ordini.novecento@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=Ordini Novecento <ordini.novecento@gmail.com>

# Laboratorio che riceve gli ordini (modificabile anche da Admin > Impostazioni)
ORDINI_EMAIL_DESTINATARI=laboratorio@example.com
